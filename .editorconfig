# 에디터 공통 설정 (VS Code 는 EditorConfig 확장 설치)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# 네이티브 파일은 생성된 형식을 그대로 따릅니다.
[*.{kt,kts,java,swift,gradle}]
indent_size = 4

[*.pbxproj]
indent_style = tab
